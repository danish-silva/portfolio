---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
import Icon from './icons/Icon.astro';
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
---

<section id="contact" class="section" aria-labelledby="contact-heading">
  <SectionHeading id="contact-heading">Contact</SectionHeading>
  <p class="contact-availability" data-reveal>{profile.availability}</p>
  <ul class="contact-actions" data-reveal-group aria-label="Ways to get in touch">
    <li>
      <a class="button button-primary glass" href={`mailto:${profile.email}`}>
        <Icon name="mail" />Email Me
      </a>
    </li>
    <li class="contact-email glass"><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    <li><a class="button glass" href={profile.linkedin} rel="me noopener"><LinkedInIcon />LinkedIn</a></li>
    <li><a class="button glass" href={profile.github} rel="me noopener"><GitHubIcon />GitHub</a></li>
    <li>
      <a class="button glass" href={profile.resume} download>
        <Icon name="download" />{profile.cta.tertiary.label}
      </a>
    </li>
  </ul>
</section>
