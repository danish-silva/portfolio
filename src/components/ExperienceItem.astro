---
import { render, type CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { formatRange } from '../utils/dates';

interface Props {
  role: CollectionEntry<'experience'>;
}

const { role } = Astro.props;
const { title, company, client, employmentType, location, startDate, endDate, current, tags } =
  role.data;
const { Content } = await render(role);

const organisation = client ? `${company}, Client: ${client}` : company;
// Dates sit on the title row rather than in this line, so the two facts a
// recruiter scans for, the role and when it ran, share one line.
const dates = formatRange(startDate, endDate, current);
const meta = [employmentType, location].filter(Boolean);
---

<article class="role">
  <header class="role-header">
    <div class="role-headline">
      <h3 class="role-title">{title}</h3>
      {dates && <p class="role-dates">{dates}</p>}
    </div>
    <p class="role-org">{organisation}</p>
    <p class="role-meta">
      {meta.map((item) => <span>{item}</span>)}
    </p>
  </header>
  <div class="prose role-body">
    <Content />
  </div>
  <TagList tags={tags} label="Skills used" />
</article>
