---
import { profile } from '../data/profile';
import Icon from './icons/Icon.astro';
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
---

<section class="hero" aria-labelledby="hero-heading" data-reveal-group>
  <h1 id="hero-heading">{profile.name}</h1>
  <p class="hero-tagline">{profile.tagline}</p>
  <ul class="hero-keywords" aria-label="Areas of interest">
    {profile.keywords.map((keyword) => <li>{keyword}</li>)}
  </ul>
  <ul class="hero-actions" aria-label="Primary actions">
    <li>
      <a class="button button-primary glass" href={profile.cta.primary.href}>
        {profile.cta.primary.label}
      </a>
    </li>
    <li><a class="button glass" href={profile.cta.secondary.href}>{profile.cta.secondary.label}</a></li>
    <li><a class="button glass" href={profile.linkedin} rel="me noopener"><LinkedInIcon />LinkedIn</a></li>
    <li><a class="button glass" href={profile.github} rel="me noopener"><GitHubIcon />GitHub</a></li>
    <li>
      <a class="button glass" href={profile.resume} download>
        <Icon name="download" />{profile.cta.tertiary.label}
      </a>
    </li>
  </ul>
</section>
