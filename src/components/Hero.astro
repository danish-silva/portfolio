---
import { profile } from '../data/profile';
import GitHubIcon from './icons/GitHubIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
---

<section class="hero" aria-labelledby="hero-heading">
  <p class="hero-location">{profile.location}</p>
  <h1 id="hero-heading">{profile.name}</h1>
  <p class="hero-tagline">{profile.tagline}</p>
  <ul class="hero-keywords" aria-label="Areas of interest">
    {profile.keywords.map((keyword) => <li>{keyword}</li>)}
  </ul>
  <div class="hero-actions">
    <a class="button button-primary" href={profile.cta.primary.href}>{profile.cta.primary.label}</a>
    <a class="button" href={profile.cta.secondary.href}>{profile.cta.secondary.label}</a>
    <a class="button" href={profile.cta.tertiary.href} download>{profile.cta.tertiary.label}</a>
    <ul class="hero-links" aria-label="Profiles">
      <li>
        <a class="button" href={profile.github} rel="me noopener"><GitHubIcon />GitHub</a>
      </li>
      <li>
        <a class="button" href={profile.linkedin} rel="me noopener"><LinkedInIcon />LinkedIn</a>
      </li>
    </ul>
  </div>
</section>
