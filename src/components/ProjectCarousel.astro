---
// Cover plus gallery as one horizontally scrolling strip.
//
// The track is a real scroll container with scroll snapping, so with no
// JavaScript at all it is still swipeable on touch and scrollable on desktop.
// The buttons and the counter are enhancements on top of that, and are hidden
// until the script attaches.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImageSlot from './ImageSlot.astro';
import Icon from './icons/Icon.astro';

interface ImageSlide {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface VideoSlide {
  video: string;
  poster?: ImageMetadata;
  alt: string;
  caption?: string;
}

type Slide = ImageSlide | VideoSlide;

interface Props {
  slides: Slide[];
  title: string;
  id: string;
}

const { slides, title, id } = Astro.props;

const isVideo = (slide: Slide): slide is VideoSlide => 'video' in slide;

// Slides are presented in a fixed 3:2 frame, so anything shot in another shape
// leaves the frame part empty. A blurred, dimmed copy of the media fills that
// space, which reads as deliberate where a flat panel reads as a gap. Media
// that already matches the frame covers it completely, so it gets no backdrop
// at all rather than a hidden image nobody will ever see.
const FRAME_RATIO = 3 / 2;

function backdropFor(slide: Slide) {
  const source = isVideo(slide) ? slide.poster : slide.src;
  if (!source) return undefined;
  const ratio = source.width / source.height;
  return Math.abs(ratio - FRAME_RATIO) / FRAME_RATIO > 0.02 ? source : undefined;
}
---

{
  slides.length === 0 ? (
    <figure class="project-cover">
      <ImageSlot label={`cover image for ${title}`} />
    </figure>
  ) : (
    <section
      class="carousel"
      data-carousel
      aria-roledescription="carousel"
      aria-label={`Images of ${title}`}
    >
      <ul class="carousel-track" id={`${id}-track`} data-carousel-track tabindex="0">
        {slides.map((slide, index) => (
          <li
            class="carousel-slide"
            data-carousel-slide
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${slides.length}`}
          >
            <figure>
              <div class="carousel-frame">
              {backdropFor(slide) && (
                <Image
                  class="carousel-backdrop"
                  src={backdropFor(slide)!}
                  alt=""
                  aria-hidden="true"
                  width={96}
                  densities={[1]}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              )}
              {isVideo(slide) ? (
                <video
                  class="carousel-media"
                  controls
                  playsinline
                  preload="metadata"
                  src={slide.video}
                  poster={slide.poster?.src}
                  aria-label={slide.alt}
                />
              ) : (
                <Image
                  class="carousel-media"
                  src={slide.src}
                  alt={slide.alt}
                  widths={[640, 1024, 1600]}
                  sizes="(min-width: 68rem) 64rem, 100vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              )}
              </div>
              {slide.caption && <figcaption>{slide.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>

      {slides.length > 1 && (
        <div class="carousel-controls" data-carousel-controls hidden>
          <p class="carousel-count" data-carousel-count aria-live="polite">
            1 / {slides.length}
          </p>
          <button
            type="button"
            class="carousel-button"
            data-carousel-prev
            aria-controls={`${id}-track`}
            aria-label="Previous image"
          >
            <Icon name="arrow-left" size={18} />
          </button>
          <button
            type="button"
            class="carousel-button"
            data-carousel-next
            aria-controls={`${id}-track`}
            aria-label="Next image"
          >
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      )}
    </section>
  )
}

<script>
  // One handler for every carousel on the page: the standalone project page
  // has one, the home page has one inside each project popup.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]');
    if (!track || !controls) continue;

    const slides = [...track.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const previous = controls.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = controls.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const count = controls.querySelector<HTMLElement>('[data-carousel-count]');
    if (slides.length < 2 || !previous || !next || !count) continue;

    let index = 0;

    // Leaving a slide has to stop whatever was playing on it. Without this a
    // clip keeps running, and keeps making noise, from a slide nobody can see.
    function pauseAllExcept(keep: number | null) {
      slides.forEach((slide, i) => {
        if (i === keep) return;
        for (const clip of slide.querySelectorAll('video')) clip.pause();
      });
    }

    function render() {
      count!.textContent = `${index + 1} / ${slides.length}`;
      previous!.disabled = index === 0;
      next!.disabled = index === slides.length - 1;
      pauseAllExcept(index);
    }

    function goTo(target: number) {
      index = Math.max(0, Math.min(slides.length - 1, target));
      // Scrolling the track directly, rather than scrollIntoView, so the page
      // itself never moves when a slide changes.
      track!.scrollTo({
        left: slides[index].offsetLeft - track!.offsetLeft,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
      render();
    }

    previous.addEventListener('click', () => goTo(index - 1));
    next.addEventListener('click', () => goTo(index + 1));

    // Swiping has to update the counter too. The observer is only the
    // trigger; the index itself is read back from the scroll position.
    // Trusting the entries directly gets this wrong, because the first
    // callback reports every slide as intersecting before the track has been
    // laid out, and whichever fires last wins.
    function nearestSlide() {
      const x = track!.scrollLeft;
      let best = 0;
      let shortest = Infinity;
      slides.forEach((slide, i) => {
        const distance = Math.abs(slide.offsetLeft - track!.offsetLeft - x);
        if (distance < shortest) {
          shortest = distance;
          best = i;
        }
      });
      return best;
    }

    const observer = new IntersectionObserver(
      () => {
        index = nearestSlide();
        render();
      },
      { root: track, threshold: 0.6 },
    );
    for (const slide of slides) observer.observe(slide);

    // A dialog opens on a carousel that may have been left mid-scroll.
    carousel.addEventListener('carousel:reset', () => {
      track.scrollTo({ left: 0, behavior: 'auto' });
      index = 0;
      render();
    });

    // Closing the popup leaves nothing visible, so nothing should be playing.
    carousel.addEventListener('carousel:stop', () => pauseAllExcept(null));

    render();
    controls.hidden = false;
  }
</script>
