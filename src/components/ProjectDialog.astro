---
// Native <dialog> holding one project's full writeup. Gives focus trapping,
// Escape to close and focus restore without any library. The inner wrapper
// carries the padding so a click on the backdrop is distinguishable from a
// click inside the content.
import type { CollectionEntry } from 'astro:content';
import ProjectDetail from './ProjectDetail.astro';
import Icon from './icons/Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const id = `project-${project.id}`;
---

<dialog class="project-dialog" id={id} aria-labelledby={`${id}-title`}>
  <div class="project-dialog-inner">
    <div class="project-dialog-bar">
      <!--
        Expand leaves the popup for the project's own page, which already
        exists for shared links and for visitors without JavaScript. Both
        controls are icon only, so each carries a label naming the project.
      -->
      <a
        class="dialog-action dialog-expand"
        href={`/projects/${project.id}`}
        aria-label={`Open ${project.data.title} as a full page`}
      >
        <Icon name="expand" size={18} />
      </a>
      <button
        type="button"
        class="dialog-action dialog-close"
        data-project-close
        aria-label={`Close ${project.data.title}`}
      >
        <Icon name="close" size={18} />
      </button>
    </div>
    <ProjectDetail project={project} headingId={`${id}-title`} />
  </div>
</dialog>
