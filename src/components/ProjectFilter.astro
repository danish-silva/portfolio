---
// Tag filter buttons. Hidden until the script in Projects.astro attaches,
// since without JS every project is simply shown.
import { tagLabel } from '../data/tags';

interface Props {
  tags: readonly string[];
}

const { tags } = Astro.props;
---

<div class="project-filter" data-project-filter role="group" aria-label="Filter projects by tag" hidden>
  <button type="button" class="button glass" data-filter="all" aria-pressed="true">All</button>
  {
    tags.map((tag) => (
      <button type="button" class="button glass" data-filter={tag} aria-pressed="false">
        {tagLabel(tag)}
      </button>
    ))
  }
</div>
