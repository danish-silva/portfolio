---
import { tagLabel } from '../data/tags';

interface Props {
  tags: readonly string[];
  label?: string;
}

const { tags, label = 'Tags' } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list" aria-label={label}>
      {tags.map((tag) => (
        <li>{tagLabel(tag)}</li>
      ))}
    </ul>
  )
}
