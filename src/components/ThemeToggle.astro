---
// Light and dark toggle. Hidden until the script attaches, since without JS
// the site simply follows the system preference. The button is a pressed
// toggle for dark mode: pressed means dark is on.
---

<button type="button" class="button button-small" data-theme-toggle aria-pressed="false" hidden>
  Dark mode
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

  function currentTheme(): 'light' | 'dark' {
    const chosen = root.getAttribute('data-theme');
    if (chosen === 'light' || chosen === 'dark') return chosen;
    return systemDark.matches ? 'dark' : 'light';
  }

  function render() {
    if (!button) return;
    const dark = currentTheme() === 'dark';
    button.textContent = dark ? 'Light mode' : 'Dark mode';
    button.setAttribute('aria-pressed', String(dark));
  }

  if (button) {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.classList.add('theme-transition');
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable: the choice lasts for this page only */
      }
      render();
      window.setTimeout(() => root.classList.remove('theme-transition'), 300);
    });

    // Follow the system if it changes and no choice has been stored.
    systemDark.addEventListener('change', render);

    render();
    button.hidden = false;
  }
</script>
