---
// Variable fonts, self hosted. Each family declares every subset with a
// unicode-range, so a latin page downloads only the latin file and ignores
// the rest. Imported before global.css so the faces exist when the tokens
// that reference them are read.
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ShaderBackground from '../components/ShaderBackground';
import { profile } from '../data/profile';
import { background } from '../data/background';

interface Props {
  title: string;
  description?: string;
  /* A page specific preview image. Project pages pass their cover; everything
     else falls back to the card built from the name and the keyword row. */
  image?: string;
  /* 404 and anything else that should not be indexed or treated as canonical. */
  noindex?: boolean;
}

const { title, description = profile.tagline, image, noindex = false } = Astro.props;
const fullTitle = title === profile.name ? title : `${title} | ${profile.name}`;

// Open Graph and canonical both need absolute URLs, so everything here is
// resolved against `site` in astro.config.mjs rather than left site relative.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!--
      The hero heading is the largest contentful paint on this page, so the
      face it is set in is fetched at the same time as the stylesheet rather
      than after it. Only the sans is preloaded: the mono carries dates and
      labels, none of which are the LCP element.
    -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />

    <!--
      SVG first for browsers that take it, ICO as the fallback, and the PNG
      for iOS, which ignores both. The mark is purple rather than the page
      background: #0e0b16 reaches only 1.21:1 against Chrome's dark tab strip,
      so a site coloured icon would be invisible in the one place it is meant
      to identify the tab.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${profile.name}, ${description}`} />
    <meta property="og:locale" content="en_AU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Arm the scroll reveal before the first paint. Doing this here rather
      // than in the module below is what stops content painting and then
      // jumping. If the module never runs, its failure path un-arms this.
      document.documentElement.dataset.reveal = 'on';
    </script>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true" style={`--bg-dim: ${background.dim}`}>
      <ShaderBackground client:only="react" />
    </div>
    <a class="skip-link" href="#main">Skip to Content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal on scroll. No scroll listener: those run on every frame and
      // cannot be batched. IntersectionObserver does the same job off the
      // main thread's critical path.
      const root = document.documentElement;

      function revealEverything() {
        root.dataset.reveal = 'off';
      }

      try {
        if (!('IntersectionObserver' in window)) {
          revealEverything();
        } else {
          // Children of a group animate in sequence. The cap keeps the last
          // item in a long grid from waiting noticeably.
          for (const group of document.querySelectorAll('[data-reveal-group]')) {
            [...group.children].forEach((child, index) => {
              if (!(child instanceof HTMLElement)) return;
              child.setAttribute('data-reveal', '');
              child.style.setProperty('--reveal-index', String(Math.min(index, 6)));
            });
          }

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.setAttribute('data-visible', '');
                observer.unobserve(entry.target);
              }
            },
            // Start slightly before the element is fully in view, so the
            // motion finishes about when the reader arrives at it.
            { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
          );

          for (const element of document.querySelectorAll('[data-reveal]')) {
            observer.observe(element);
          }
        }
      } catch {
        // Never leave the page hidden because the animation failed.
        revealEverything();
      }
    </script>
  </body>
</html>
