{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers project name — shows up in the dashboard and default
  // workers.dev subdomain. Change if you want a different slug.
  "name": "portfolio",
  "compatibility_date": "2026-08-25",
  // Astro's static build output. `npx wrangler deploy` serves this directory
  // directly as a Worker with static assets — no Worker script required.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
